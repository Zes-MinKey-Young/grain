{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node10",
        "lib": ["ES2022"],
        "outDir": "dist",
        "rootDir": "..",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "types": ["node", "vscode"]
    },
    "include": ["src/**/*.ts", "../compiler/**/*.ts"]
}
