{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node10",
        "lib": ["ES2022"],
        "outDir": "dist",
        "rootDir": "..",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "types": ["node", "vscode"],
        "allowImportingTsExtensions": true,
        "emitDeclarationOnly": true,
        "declaration": true
    },
    "include": ["src/**/*.ts", "../compiler/**/*.ts"],
    "exclude": ["../compiler/**/*.test.ts"]
}
