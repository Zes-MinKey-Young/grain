{
    "name": "grain-vscode",
    "displayName": "Grain",
    "description": "Grain language support: syntax highlighting, diagnostics, go-to-definition, hover, completion and component prop hints",
    "version": "0.1.2",
    "publisher": "grain",
    "license": "MIT",
    "icon": "images/icon.png",
    "keywords": [
        "grain",
        "svelte",
        "typescript",
        "compiler"
    ],
    "engines": {
        "vscode": "^1.140.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onLanguage:grain",
        "onCommand:grain.compileJs",
        "onCommand:grain.compileCss"
    ],
    "contributes": {
        "configurationDefaults": {
            "[grain]": {
                "editor.wordBasedSuggestions": "off",
                "editor.inlineSuggest.suppressSuggestions": false
            }
        },
        "languages": [
            {
                "id": "grain",
                "aliases": [
                    "Grain",
                    "grain"
                ],
                "extensions": [
                    ".grain"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "grain",
                "scopeName": "source.grain",
                "path": "./syntaxes/grain.tmLanguage.json",
                "embeddedLanguages": {
                    "source.ts": "typescript",
                    "source.css": "css"
                }
            }
        ],
        "commands": [
            {
                "command": "grain.compileJs",
                "title": "Grain: Compile current file → JS"
            },
            {
                "command": "grain.compileCss",
                "title": "Grain: Compile current file → CSS"
            }
        ],
        "configuration": {
            "title": "Grain",
            "properties": {
                "grain.semanticDiagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "Report type errors from the TypeScript language service (turn off to only report syntax errors)"
                },
                "grain.debug": {
                    "type": "boolean",
                    "default": false,
                    "description": "Debug log: also writes to Output → Log (Extension Host) and reveals the Output → Grain channel (the Grain channel always logs, this only adds the extra copy)"
                }
            }
        }
    },
    "scripts": {
        "build": "tsc -p . --ignoreDeprecations 6.0",
        "watch": "tsc -p . --ignoreDeprecations 6.0 --watch",
        "libs": "node scripts/copy-ts-lib.mjs",
        "bundle": "esbuild dist/vscode/src/extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js && pnpm libs",
        "package": "pnpm build && pnpm bundle && vsce package --no-dependencies --allow-missing-repository --no-git-tag-version",
        "publish:marketplace": "pnpm build && pnpm bundle && vsce publish --no-dependencies --allow-missing-repository --no-git-tag-version"
    },
    "dependencies": {
        "@typescript-eslint/typescript-estree": "^8.71.0",
        "css-tree": "^3.2.1",
        "typescript": "6.0.3"
    },
    "devDependencies": {
        "@types/vscode": "^1.140.0",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.27.0",
        "typescript": "6.0.3"
    }
}
