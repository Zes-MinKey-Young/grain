{
    "name": "@graints/vite-plugin",
    "version": "0.4.2",
    "description": "Vite plugin that compiles .grain components",
    "license": "MIT",
    "type": "module",
    "main": "./dist/vite-plugin/index.js",
    "types": "./dist/vite-plugin/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/vite-plugin/index.d.ts",
            "default": "./dist/vite-plugin/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "bun build ../compiler/index.ts --outfile dist/compiler/index.js --target node --format esm --external typescript --external css-tree --external oxc-parser && tsc -p . --emitDeclarationOnly && bun build index.ts --outfile dist/vite-plugin/index.js --target node --format esm --external typescript --external css-tree --external oxc-parser"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "peerDependencies": {
        "vite": ">=6"
    },
    "dependencies": {
        "@typescript-eslint/typescript-estree": "^8.71.0",
        "css-tree": "^3.2.1",
        "oxc-parser": "^0.153.0",
        "typescript": ">=5.0.0 <7.0.0"
    }
}
