{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUnusedLocals": false,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        // `$state` / `$props` / `$bindable` / `*.grain` 来自这里（runtime 包自带的全局声明）
        "types": ["@graints/runtime"]
    },
    "include": ["src"]
}
