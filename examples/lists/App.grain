<script>
    import { addRow, addTag, dropRow, rows, tags } from './rows';

    // A plain `$state` array: the compiler sees every write to it and turns
    // `push` / `shift` / `splice` into the matching precise call
    let todos = $state([
        { id: 1, text: 'write the parser' },
        { id: 2, text: 'write the runtime' }
    ]);

    let nextId = $state(3);

    function addTodo() {
        todos.push({ id: nextId, text: `todo ${nextId}` });
        nextId += 1;
    }

    function dropFirst() {
        todos.shift();
    }

    function replaceSecond() {
        todos.splice(1, 1, { id: 100, text: 'replaced' });
    }

    function flip() {
        todos = [todos[1], todos[0]];
    }
    function flipInPlace() {
        [todos[0], todos[1]] = [todos[1], todos[0]];
    }

    // A `$state` Map / Set: `set` / `delete` / `add` / `clear` locate the one row by its
    // key, so only that row is touched (needs `with key = ...`)
    let scores = $state(new Map([['ada', 1]]));
    let picked = $state(new Set(['red']));

    function score(name, value) {
        scores.set(name, value);
    }

    function unscore(name) {
        scores.delete(name);
    }

    function pick(color) {
        picked.add(color);
    }

    function unpick(color) {
        picked.delete(color);
    }

    function resetScores() {
        scores.clear();
    }
</script>

<h2>1 · keyed for over a $state array</h2>
<p class="hint">matched by id — push / shift / splice only touch the rows they affect</p>

{#for todo of todos with key = todo.id}
    <p class="row">{todo.id} — {todo.text} <code>Math.random() =</code> {Math.random()}</p>
{:else}
    <p class="row">empty</p>
{/for}

<p class="buttons">
    <button onclick={addTodo}>push</button>
    <button onclick={dropFirst}>shift</button>
    <button onclick={replaceSecond}>splice(1, 1)</button>
    <button onclick={flip}>reorder (replacing the array)</button>
    <button onclick={flipInPlace}>reorder (in-place)</button>
</p>

<h2>2 · keyed for over a reactive array</h2>
<p class="hint">rows is a reactiveArray, and it is mutated in ./rows — outside this component, where the compiler cannot see it</p>

{#for row of rows with key = row}
    <p class="row">{row} <code>Math.random() =</code> {Math.random()}</p>
{:else}
    <p class="row">empty</p>
{/for}

<p class="buttons">
    <button onclick={addRow}>push (from the other module)</button>
    <button onclick={dropRow}>shift (from the other module)</button>
</p>

<h2>3 · reactive Set</h2>

{#for tag of tags}
    <p class="row">{tag} <code>Math.random() =</code> {Math.random()}</p>
{:else}
    <p class="row">empty</p>
{/for}

<p class="buttons">
    <button onclick={addTag}>add</button>
</p>

<h2>4 · entries()</h2>
<p class="hint">the same array, with its index</p>

{#for [i, todo] of todos.entries() with key = i}
    <p class="row">[{i}] {todo.text} <code>Math.random() =</code> {Math.random()}</p>
{/for}

<h2>5 · Map and Set</h2>
<p class="hint">
    matched by key — <code>set</code> / <code>delete</code> / <code>add</code> / <code>clear</code>
    touch just the row they name (the first two values are unchanged, so their
    <code>Math.random()</code> stays put)
</p>

{#for [name, value] of scores with key = name}
    <p class="row">{name} = {value} <code>Math.random() =</code> {Math.random()}</p>
{/for}

<p class="buttons">
    <button onclick={() => score('ada', 10)}>set ada=10</button>
    <button onclick={() => score('bob', 20)}>set bob=20</button>
    <button onclick={() => unscore('ada')}>delete ada</button>
    <button onclick={resetScores}>clear</button>
</p>

{#for color of picked with key = color}
    <p class="row">#{color} <code>Math.random() =</code> {Math.random()}</p>
{/for}

<p class="buttons">
    <button onclick={() => pick('blue')}>add blue</button>
    <button onclick={() => unpick('red')}>delete red</button>
</p>

<style>
    h2 {
        font-size: 1rem;
        margin: 1.5rem 0 0.5rem;
    }

    .hint {
        color: #666;
        font-size: 0.85rem;
        margin: 0 0 0.5rem;
    }

    .row {
        margin: 0.15rem 0;
        padding: 0.2rem 0.4rem;
        background: #f4f4f5;
    }

    .buttons {
        margin: 0.5rem 0 0;
    }

    button {
        margin-right: 0.4rem;
    }
</style>
