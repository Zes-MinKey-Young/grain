<script>
    import { name } from './store';
    import Box from './Box.grain';

    // 派生：store 变了它重算。编译器看不见这层依赖，所以要给它一个 listen
    const upper = $node({ get: () => name.get().toUpperCase(), listen: (update) => name.subscribe(update) });

    function reset() {
        name.set('ada');
    }
</script>

<h2>Two inputs, one store</h2>
<p>
    <input bind:value={$store(name)} />
</p>
<p>
    <input bind:value={$store(name)} />
</p>

<h2>Same store, from another component</h2>
<Box />

<h2>Derived in the script ($node)</h2>
<p>Upper: {upper}</p>

<p>
    <button onclick={reset}>reset</button>
</p>

<style>
    input {
        padding: 0.3rem 0.5rem;
    }

    h2 {
        font-size: 1rem;
        margin: 1.5rem 0 0.5rem;
    }
</style>
