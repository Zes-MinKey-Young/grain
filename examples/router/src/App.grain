<script>
    import routes from "grain:routes";
    import { createRouter } from "@graints/runtime";
</script>

<nav>
    <a href="/">home</a>
    <a href="/about">about</a>
</nav>

<main id="outlet"></main>

<script onmount>
    // 路由表是插件扫 src/routes 生成的（编译期），页面懒加载
    const outlet = document.getElementById("outlet");

    createRouter({ routes, target: outlet }).start();
</script>

<style>
    nav {
        padding: 8px;
        background: #eee;
    }
    nav a {
        margin-right: 10px;
    }
    main {
        padding: 12px;
    }
</style>
