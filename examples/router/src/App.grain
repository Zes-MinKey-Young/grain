<script>
    import routes from "grain:routes";
    import { createRouter, normalize } from "@graints/runtime";

    let outlet;

    // 路由表是插件扫 `src/routes` 生成的；页面懒加载
    const router = createRouter({ routes, target: outlet });

    router.start();
</script>

<nav>
    <a href="/">home</a>
    <a href="/about">about</a>
</nav>

<main bind:this={outlet}></main>

<style>
    nav {
        padding: 8px;
        background: #eee;
    }
    nav a {
        margin-right: 10px;
    }
    main {
        padding: 12px;
    }
</style>
