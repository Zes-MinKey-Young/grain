<script>
    import { highlight } from "./highlight.ts";

    let { code, note } = $props<{ code: string; note?: string }>();

    // 去掉首尾的空行和公共缩进，这样模板字符串里怎么排版都行
    const trimmed = code.replace(/^\n+|\n+$/g, "");

    let pieces = highlight(trimmed);
</script>

<figure>
    <pre>{#for piece of pieces}<span class={piece.kind}>{piece.text}</span>{/for}</pre>
    {#if note}
        <figcaption>{note}</figcaption>
    {/if}
</figure>

<style>
    figure {
        margin: 0;
    }
    pre {
        margin: 0;
        padding: 10px 12px;
        background: #1e1e1e;
        border-radius: 6px;
        overflow-x: auto;
        line-height: 1.5;
        tab-size: 4;
    }
    figcaption {
        margin-top: 4px;
        font-size: 0.85em;
        opacity: 0.7;
    }
    .comment { color: #6a9955; }
    .string { color: #ce9178; }
    .rune { color: #dcdcaa; font-weight: 600; }
    .block { color: #c586c0; font-weight: 600; }
    .interp { color: #ffd700; }
    .tag { color: #569cd6; }
    .attr { color: #9cdcfe; }
    .keyword { color: #569cd6; }
    .number { color: #b5cea8; }
    .punct { color: #d4d4d4; }
    .plain { color: #d4d4d4; }
</style>
